# Python build and bytecode
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# uv-managed virtualenv. Recreate with `uv sync`; uv.lock IS committed so the
# environment is reproducible without shipping 300MB of packages.
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Downloaded data: re-fetchable via scripts/update_data.py, and it changes
# every matchweek, so pinning it in git would create constant churn. The
# column metadata is hand-written documentation, so it is tracked.
data/*
!data/matches_metadata.yaml

# Fitted model artifacts: reproducible from scripts/fit_model.py.
artifacts/

# Credentials. Never track key material.
.env
*.pem
*.key
secrets/
# Shell rc files sometimes get dropped in a project root while exporting a
# token for a one-off push. They do not belong in a repository, and a public
# one would leak the token permanently.
.bashrc
.bash_profile
.zshrc
.netrc
*.token

*.zip
